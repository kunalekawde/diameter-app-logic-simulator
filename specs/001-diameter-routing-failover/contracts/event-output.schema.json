{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/diameter-routing-demo/event-output.schema.json",
  "title": "Diameter Routing Demo Run Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disclaimer",
    "run_id",
    "scenario_id",
    "seed",
    "events",
    "results"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "disclaimer": {
      "const": "Simulation-only educational demo; not a conformant or production Diameter implementation."
    },
    "run_id": { "$ref": "#/$defs/nonEmptyString" },
    "scenario_id": { "$ref": "#/$defs/nonEmptyString" },
    "seed": { "type": "integer", "minimum": 0 },
    "events": {
      "type": "array",
      "maxItems": 2048,
      "items": { "$ref": "#/$defs/event" }
    },
    "results": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableString": { "type": ["string", "null"] },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "scenario_id",
        "sequence",
        "simulated_time_ms",
        "component",
        "event_type",
        "operation_id",
        "transaction_id",
        "attempt",
        "peer",
        "severity",
        "code",
        "detail"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "scenario_id": { "$ref": "#/$defs/nonEmptyString" },
        "sequence": { "type": "integer", "minimum": 1 },
        "simulated_time_ms": { "type": "integer", "minimum": 0 },
        "component": {
          "enum": ["validation", "routing", "queue", "transaction", "peer", "retry", "shutdown", "result"]
        },
        "event_type": { "$ref": "#/$defs/nonEmptyString" },
        "operation_id": { "$ref": "#/$defs/nullableString" },
        "transaction_id": { "$ref": "#/$defs/nullableString" },
        "attempt": { "type": ["integer", "null"], "minimum": 1, "maximum": 2 },
        "peer": { "$ref": "#/$defs/nullableString" },
        "severity": { "enum": ["INFO", "WARN", "ERROR"] },
        "code": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "type": "string" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "code",
        "completed_at_ms",
        "attempt_count",
        "peer",
        "detail"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/nonEmptyString" },
        "code": { "$ref": "#/$defs/nonEmptyString" },
        "completed_at_ms": { "type": "integer", "minimum": 0 },
        "attempt_count": { "type": "integer", "minimum": 0, "maximum": 2 },
        "peer": { "$ref": "#/$defs/nullableString" },
        "detail": { "type": "string" }
      }
    }
  }
}
